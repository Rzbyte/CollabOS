# CollabOS environment configuration.
#
# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env
#
# Validated at startup by src/env.ts (Zod). The app refuses to boot on a bad config
# rather than failing later in a request handler.

# ---------------------------------------------------------------------------
# Minds platform (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Create at https://build.hellominds.ai/console  → sign in → Keys → Create
MINDS_BUILDER_API_KEY=
# Find with `minds list --pretty` (once the key above is set), or via
# https://hellominds.ai/profile
MINDS_MIND_ID=

# ---------------------------------------------------------------------------
# Circle collaborator
# ---------------------------------------------------------------------------
# A real inbox YOU control. This is the ONLY email CollabOS will ever add to the
# Mind's Circle — arbitrary emails from browser input are rejected by design.
COLLABORATOR_TEST_EMAIL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://collabos:collabos@localhost:5432/collabos

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — LOCAL TEST TRANSPORT ONLY
# ---------------------------------------------------------------------------
# "mailpit" captures every message locally at http://localhost:8025 and delivers
# nothing to the public internet. "console" logs instead of sending.
# There is no real-provider transport in this milestone by design.
EMAIL_TRANSPORT=mailpit
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Autonomy timing
# ---------------------------------------------------------------------------
# Deliverable deadline in development mode. 180s = the 3-minute demo window.
FOLLOW_UP_DELAY_SECONDS=180

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Mailpit web UI port, used to deep-link captured messages from the UI.
MAILPIT_HTTP_PORT=8025
# HMAC secret for signed collaborator acceptance links. A dev default is used
# when unset; set an explicit value for any shared environment.
LINK_SIGNING_SECRET=
# Milliseconds to wait for a Mind reply before treating the call as timed out.
MINDS_REPLY_TIMEOUT_MS=120000
